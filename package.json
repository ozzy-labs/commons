{
  "name": "commons",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "lefthook install || true",
    "lint:md": "markdownlint-cli2 '**/*.md' '!node_modules'",
    "lint:yaml": "yamlfmt -lint . && yamllint -c .yamllint.yaml .",
    "lint:shell": "find . -name '*.sh' -not -path './node_modules/*' -exec shellcheck {} + && find . -name '*.sh' -not -path './node_modules/*' -exec shfmt -d {} +",
    "lint:secrets": "gitleaks detect --no-banner",
    "lint:format": "prettier --check --ignore-path=.prettierignore '**/*.{md,json,yaml,yml}'",
    "lint:format:fix": "prettier --write --ignore-path=.prettierignore '**/*.{md,json,yaml,yml}'",
    "lint:all": "pnpm run lint:md && pnpm run lint:yaml && pnpm run lint:format && pnpm run lint:shell && pnpm run lint:secrets",
    "test": "bats tests/"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  }
}
